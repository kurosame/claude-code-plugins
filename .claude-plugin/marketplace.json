{
  "name": "kurosame-claude-code-plugins",
  "description": "Claude Code plugins for AI-driven code review and development, run locally or in CI.",
  "owner": {
    "name": "kurosame",
    "url": "https://github.com/kurosame"
  },
  "plugins": [
    {
      "name": "code-review",
      "source": "./code-review",
      "description": "Read-only code review slash commands with stack-specific variants under `/review-<stack>`. Reports findings without editing files. Third-party skills used by each stack are declared as dependencies and auto-installed from this marketplace."
    },
    {
      "name": "task",
      "source": "./task",
      "description": "Loads a task description from `.claude-task.md` and surfaces it as findings for `/apply-fix` to consume. Read-only — reports findings without editing files."
    },
    {
      "name": "ai-config",
      "source": "./ai-config",
      "description": "Reviews the entire codebase against the project's AI meta configuration files and reports what should be added, updated, or created. Read-only — reports findings without editing files."
    },
    {
      "name": "playwright-e2e",
      "source": "./playwright-e2e",
      "description": "Slash commands that orchestrate Playwright's auto-generated planner / generator / healer agents for end-to-end testing in CI. Pairs with `npx playwright init-agents --loop=claude`."
    },
    {
      "name": "apply-fix",
      "source": "./apply-fix",
      "description": "Applies fixes (from prior review findings or check failures) and iterates the project's check commands (lint, type-check, build, test) until all pass. Depends on `ponytail` (auto-installed from this marketplace) to keep the applied fixes minimal."
    },
    {
      "name": "pr",
      "source": "./pr",
      "description": "Groups uncommitted changes by relatedness and opens one PR per group from a fresh branch off main (falls back to a single PR when only one group)."
    },
